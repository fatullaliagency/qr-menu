generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  phone        String
  pinCode      String?    @default("1234")
  subtitle     String?
  slogan       String?
  description  String?
  logoUrl      String?
  bgImageUrl   String?
  heroFoodUrl  String?
  wifiName     String?
  wifiPassword String?
  address      String?
  workingHours String?
  instagramUrl String?
  facebookUrl  String?
  mapUrl       String?
  categories   Category[]
  menuItems    MenuItem[]
}

model Category {
  id           String     @id @default(cuid())
  name         String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]
}

