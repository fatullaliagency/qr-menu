generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  phone        String
  tableCount       Int     @default(0)
  dineInEnabled    Boolean @default(false)
  deliveryEnabled  Boolean @default(true)
  pickupEnabled    Boolean @default(false)
createdAt DateTime @default(now()) @db.Timestamp(3)
 pinCode String?
  subtitle     String?
  slogan       String?
  description  String?
  logoUrl      String?
  bgImageUrl   String?
  heroFoodUrl  String?
  wifiName     String?
  wifiPassword String?
  address      String?
  workingHours String?
  instagramUrl String?
  facebookUrl  String?
  mapUrl       String?
  
  categories   Category[]
  menuItems    MenuItem[]
  orders       Order[]
  paymentSettings RestaurantPaymentSettings?
  statusEvents OrderStatusEvent[]
}


model Category {
  id           String     @id @default(cuid())
  name         String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]
}

model MenuItem {
  id           String     @id @default(cuid())
  name         String
  description  String?
  price        Float
  imageUrl     String?
  video        MenuItemVideo?
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}
// Videos are isolated from menu metadata so normal menu pages never fetch binary data.
model MenuItemVideo {
  menuItemId    String   @id
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurantId  String
  mimeType      String   @db.VarChar(20)
  sizeBytes     Int
  payload       Bytes
  updatedAt     DateTime @updatedAt

  @@index([restaurantId])
}

model AdminLoginAttempt {
  key            String    @id @db.VarChar(64)
  failedAttempts Int       @default(0)
  blockedUntil   DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([updatedAt])
}
enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum OrderFulfillmentType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  ONLINE_CARD
  MANUAL_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

model Order {
  id String @id @default(cuid())

  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  customerName String
  customerPhone String?

  fulfillmentType OrderFulfillmentType @default(DELIVERY)
  tableNumber Int?

  addressText String?
  latitude Float?
  longitude Float?
  customerNote String?

  subtotal Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  total Decimal @db.Decimal(10, 2)

  status OrderStatus @default(NEW)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
  statusEvents OrderStatusEvent[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, fulfillmentType, createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  name String

  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([orderId])
}



// Ödəniş parametrləri əsas restoran və sifariş məlumatlarından ayrıca saxlanılır.
// Kartla real ödəniş yalnız provayder təsdiqi və server inteqrasiyası qurulduqdan sonra aktiv edilə bilər.
enum RestaurantPaymentMode {
  CASH_ONLY
  CASH_AND_CARD
}

enum MerchantApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model RestaurantPaymentSettings {
  restaurantId String @id
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Sahibkarın hüquqi məlumatları. VÖEN qeydiyyatı təsdiq demək deyil.
  legalName String? @db.VarChar(200)
  taxId String? @db.VarChar(10)

  // Quraşdırma niyyəti; kart checkout-un aktiv olduğunu bildirmir.
  paymentMode RestaurantPaymentMode @default(CASH_ONLY)
  providerName String? @db.VarChar(100)
  providerMerchantId String? @db.VarChar(150)
  approvalStatus MerchantApprovalStatus @default(NOT_SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


/**
 * Sifarişin yeni statusa keçmə tarixçəsi.
 * Köhnə sifarişlərə saxta keçid tarixçəsi əlavə edilmir.
 * Yalnız staging migration tətbiq edildikdən sonra istifadə olunmalıdır.
 */
model OrderStatusEvent {
  id String @id @default(cuid())

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  fromStatus OrderStatus?
  toStatus OrderStatus
  actor String @db.VarChar(16)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([orderId, createdAt])
  @@index([restaurantId, createdAt])
}


// Hotel data is a separate tenant domain. Restaurant and Order are unchanged.
enum HotelRoomStatus {
  VACANT
  OCCUPIED
  OUT_OF_SERVICE
}
enum HotelServiceCategory {
  FOOD
  ROOM_SERVICE
  EXTRA
}
enum HotelDepartment {
  KITCHEN
  HOUSEKEEPING
  RECEPTION
}
enum HotelRequestStatus {
  NEW
  ACCEPTED
  PREPARING
  DISPATCHED
  COMPLETED
}

model Hotel {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(120)
  slug       String   @unique @db.VarChar(60)
  branchName String?  @db.VarChar(120)
  phone      String   @db.VarChar(30)
  email      String?  @db.VarChar(200)
  address    String?  @db.VarChar(300)
  roomCount  Int      @default(0)
  foodEnabled Boolean @default(true)
  roomServiceEnabled Boolean @default(true)
  extraEnabled Boolean @default(true)
  pinCode    String
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  rooms    HotelRoom[]
  services HotelService[]
  requests HotelGuestRequest[]
  orders   HotelOrder[]
  events   HotelOrderEvent[]
  staff    HotelStaff[]
}

model HotelRoom {
  id        String          @id @default(cuid())
  hotelId   String
  hotel     Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number    String          @db.VarChar(20)
  status    HotelRoomStatus @default(VACANT)
  qrNonce   String          @unique @default(cuid())
  createdAt DateTime        @default(now()) @db.Timestamp(3)

  requests HotelGuestRequest[]

  @@unique([hotelId, number])
  @@index([hotelId, status])
}

model HotelService {
  id          String               @id @default(cuid())
  hotelId     String
  hotel       Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String               @db.VarChar(120)
  description String?              @db.VarChar(500)
  category    HotelServiceCategory
  department  HotelDepartment
  price       Decimal              @default(0) @db.Decimal(10, 2)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @db.Timestamp(3)

  @@index([hotelId, category, active])
  @@index([hotelId, department, active])
}

model HotelGuestRequest {
  id               String   @id @default(cuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId           String
  room             HotelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  trackingTokenHash String  @db.VarChar(64)
  clientRequestId  String   @unique @db.VarChar(36)
  createdAt        DateTime @default(now()) @db.Timestamp(3)
  orders           HotelOrder[]

  @@index([hotelId, createdAt])
  @@index([hotelId, roomId, createdAt])
}

model HotelOrder {
  id            String             @id @default(cuid())
  hotelId       String
  hotel         Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  requestId     String
  request       HotelGuestRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  department    HotelDepartment
  status        HotelRequestStatus @default(NEW)
  note          String?            @db.VarChar(500)
  total         Decimal            @db.Decimal(10, 2)
  roomCharge    Boolean            @default(true)
  createdAt     DateTime           @default(now()) @db.Timestamp(3)
  updatedAt     DateTime           @updatedAt
  items         HotelOrderItem[]
  events        HotelOrderEvent[]

  @@index([hotelId, department, status, createdAt])
  @@index([hotelId, createdAt])
}

model HotelOrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      HotelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId  String
  name       String   @db.VarChar(120)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  lineTotal  Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

model HotelOrderEvent {
  id         String             @id @default(cuid())
  hotelId    String
  hotel      Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  orderId    String
  order      HotelOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus HotelRequestStatus?
  toStatus   HotelRequestStatus
  actor      String             @db.VarChar(40)
  createdAt  DateTime           @default(now()) @db.Timestamp(3)

  @@index([hotelId, orderId, createdAt])
}

model HotelStaff {
  id             String          @id @default(cuid())
  hotelId        String
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  username       String          @db.VarChar(40)
  name           String          @db.VarChar(120)
  pinCode        String
  department     HotelDepartment
  active         Boolean         @default(true)
  sessionVersion String          @default(cuid())
  createdAt      DateTime        @default(now()) @db.Timestamp(3)

  @@unique([hotelId, username])
  @@index([hotelId, department, active])
}
